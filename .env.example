# ── minecraft-server-manager environment variables ───────────────────────
# Copy to .env (git-ignored) and fill in your values.
# All values can also be set in src/config/config.json — env vars take
# precedence and allow secrets to be injected without touching files.

# JWT signing secret — REQUIRED for sessions to survive process restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-hex-secret

# Override the web interface port (default: value in config.json)
# PORT=3001
